# Server Configuration
PORT=3000
NODE_ENV=development

# Client Configuration
VITE_API_URL=http://localhost:3000

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# JWT Configuration
JWT_SECRET=your-jwt-secret-here

# WikiMedia OAuth2 Credentials
WIKI_CLIENT_ID=your-client-id
WIKI_CLIENT_SECRET=your-client-secret
WIKI_CALLBACK_URL=http://localhost:3000/auth/mediawiki/callback

# Prisma Database Configuration
# For local development
DATABASE_URL="mysql://your_user:your_password@localhost:3306/your_database"

# For Toolforge (uncomment and modify for deployment)
# DATABASE_URL="mysql://your_tool_name:$(grep -A 1 password ~/replica.my.cnf | tail -n 1)@tools.db.svc.wikimedia.cloud:3306/your_tool_name"
