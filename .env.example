# Server Configuration
# On Toolforge (Kubernetes) PORT is injected automatically and is always 8000.
PORT=3000
NODE_ENV=development

# Public URL of the app. In production this is the Toolforge URL.
# Local dev: http://localhost:5173 (Vite dev server)
CLIENT_URL=http://localhost:5173

# Session signing secret (required). Generate a long random string, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_COOKIE_SECRET=your-session-secret-here

# WikiMedia OAuth2 Credentials
# Register a consumer at:
#   https://meta.wikimedia.org/wiki/Special:OAuthConsumerRegistration
WIKI_CLIENT_ID=your-client-id
WIKI_CLIENT_SECRET=your-client-secret
# Local dev callback:
WIKI_CALLBACK_URL=http://localhost:3000/auth/mediawiki/callback
# Production (Toolforge) callback would be:
#   https://<toolname>.toolforge.org/auth/mediawiki/callback

# Prisma / MariaDB Database Configuration
# For local development:
DATABASE_URL="mysql://your_user:your_password@localhost:3306/your_database"

# For Toolforge (ToolsDB): credentials are injected as TOOL_TOOLSDB_USER /
# TOOL_TOOLSDB_PASSWORD. Build the URL and store it as a Toolforge envvar:
#   toolforge envvars create DATABASE_URL
# Value (replace <db> with your tool's database, usually s#####__<name>):
#   mysql://$TOOL_TOOLSDB_USER:$TOOL_TOOLSDB_PASSWORD@tools.db.svc.wikimedia.cloud:3306/<db>

# Required in production: WMF's User-Agent policy requires a descriptive UA
# with real contact info for API consumers. Set this before deploying.
META_USER_AGENT="WikiTimer/1.0 (https://<toolname>.toolforge.org; <your-contact-info>)"
# Optional: cache TTL for imported Meta events in milliseconds (default 1h).
# META_EVENTS_TTL_MS=3600000
