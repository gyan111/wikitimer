generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int        @id @default(autoincrement())
  wikiId    String     @unique
  username  String
  isAdmin   Boolean    @default(false)
  createdAt DateTime   @default(now())
  timers    Timer[]
  favorites Favorite[]
}

model Favorite {
  id        Int      @id @default(autoincrement())
  userId    Int
  eventKey  String   @db.VarChar(255)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, eventKey])
  @@index([userId])
}

model Timer {
  id            Int       @id @default(autoincrement())
  type          String    @db.VarChar(50)
  name          String    @db.VarChar(255)
  link          String    @db.Text
  time          DateTime
  endTime       DateTime?
  region        String    @db.VarChar(100)
  country       String    @db.VarChar(100)
  timeZone      String    @db.VarChar(50)
  organizers    String?   @db.Text
  logo          String?   @db.VarChar(500)
  slug          String?   @db.VarChar(100)
  isMeta        Boolean   @default(false)
  metaId        String?   @unique @db.VarChar(255)
  participation String?   @db.VarChar(100)
  eventTypes    String?   @db.Text
  topics        String?   @db.Text
  wikiProject   String?   @db.VarChar(100)
  participants  Int?
  isCancelled   Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt
  creatorId     Int?
  creator       User?     @relation(fields: [creatorId], references: [id])
}

model Session {
  session_id String  @id @db.VarChar(128)
  expires    Int     @db.UnsignedInt
  data       String? @db.MediumText

  @@map("sessions")
}
